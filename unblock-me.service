[Unit]
Description=Unblock Me: rebuild dist/ on every change (served by zikoat-home)
After=network.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/unblock-me
ExecStart=/home/exedev/.bun/bin/bun scripts/build.ts --watch
Restart=on-failure

[Install]
WantedBy=multi-user.target
